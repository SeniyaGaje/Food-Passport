rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Shared catalogues are maintained in the console or by a trusted Admin SDK.
    match /restaurants/{restaurantId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /trails/{trailId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /quests/{questId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      match /visits/{visitId} { allow read, write: if isOwner(userId); }
      match /stamps/{cuisine} { allow read, write: if isOwner(userId); }
      match /quests/{questId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['type', 'targetCuisines', 'budget', 'duration', 'maxDistanceKm', 'trailID', 'startedAt', 'extendedUntil'])
          && request.resource.data.type in ['New cuisines', 'Food trail']
          && request.resource.data.duration in ['This week', 'This month']
          && request.resource.data.targetCuisines is int
          && request.resource.data.targetCuisines >= 1 && request.resource.data.targetCuisines <= 12
          && request.resource.data.budget is int && request.resource.data.budget >= 0
          && request.resource.data.maxDistanceKm is number
          && request.resource.data.maxDistanceKm >= 0.5 && request.resource.data.maxDistanceKm <= 5
          && (!request.resource.data.keys().hasAny(['trailID']) || request.resource.data.trailID == null
            || request.resource.data.trailID is string)
          && request.resource.data.startedAt is timestamp
          && (!request.resource.data.keys().hasAny(['extendedUntil'])
            || request.resource.data.extendedUntil is timestamp);
      }
      // Plan visit: the place, when, the estimate at planning time and "Count towards my quest".
      match /plannedVisits/{planId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['id', 'restaurantID', 'date', 'estimatedCost', 'countsTowardsQuest'])
          && request.resource.data.id == planId
          && request.resource.data.restaurantID is string && request.resource.data.restaurantID.size() > 0
          && request.resource.data.date is timestamp
          && request.resource.data.estimatedCost is int && request.resource.data.estimatedCost >= 0
          && request.resource.data.countsTowardsQuest is bool;
      }
      match /trails/{trailId} { allow read, write: if isOwner(userId); }
      match /challenges/{challengeId} { allow read, write: if isOwner(userId); }
      match /devices/{deviceId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0 && request.resource.data.token.size() < 4096
          && request.resource.data.platform == 'ios'
          && request.resource.data.updatedAt is timestamp;
      }
    }
  }
}
